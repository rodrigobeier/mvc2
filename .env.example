# Configurações do Banco de Dados (MySQL - ex: Aiven, FreeSQLDatabase)
DB_HOST=seu-host.aivencloud.com
DB_PORT=3306
DB_USER=seu-usuario
DB_PASSWORD=sua-senha
DB_NAME=seu-banco-de-dados
DB_SSL=true

# Segredo da Sessão (crie uma string longa e aleatória)
SESSION_SECRET=um_segredo_muito_forte_e_aleatorio

# Porta do Servidor
PORT=3000

# Ambiente (development | production)
NODE_ENV=development
