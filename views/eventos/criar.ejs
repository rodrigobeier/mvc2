<div class="card">
    <h2>Novo evento</h2>
    <% if (erro) { %><div class="erro"><%= erro %></div><% } %>
    <form action="/eventos" method="POST">
        <label for="titulo">Título</label>
        <input type="text" id="titulo" name="titulo" required>

        <label for="descricao">Descrição</label>
        <textarea id="descricao" name="descricao" rows="4"></textarea>

        <label for="data_evento">Data e hora</label>
        <input type="datetime-local" name="data" id="data" class="form-control" required>

        <label for="local">Local</label>
        <input type="text" id="local" name="local">

        <label for="vagas">Vagas</label>
        <input type="number" id="vagas" name="vagas" min="0" required>

        <div style="margin-top:1.25rem;">
            <button class="btn" type="submit">Criar evento</button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
