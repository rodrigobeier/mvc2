<div class="card">
    <h2>Editar evento</h2>
    <% if (erro) { %><div class="erro"><%= erro %></div><% } %>
    <form action="/eventos/<%= evento.id %>/editar" method="POST">
        <label for="titulo">Título</label>
        <input type="text" id="titulo" name="titulo" value="<%= evento.titulo %>" required>

        <label for="descricao">Descrição</label>
        <textarea id="descricao" name="descricao" rows="4"><%= evento.descricao %></textarea>

        <label for="data_evento">Data e hora</label>
        <input type="datetime-local" id="data_evento" name="data_evento"
               value="<%= new Date(evento.data_evento).toISOString().slice(0,16) %>" required>

        <label for="local">Local</label>
        <input type="text" id="local" name="local" value="<%= evento.local %>">

        <label for="vagas">Vagas</label>
        <input type="number" id="vagas" name="vagas" min="0" value="<%= evento.vagas %>" required>

        <div style="margin-top:1.25rem;">
            <button class="btn" type="submit">Salvar alterações</button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
